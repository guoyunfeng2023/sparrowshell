{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SparrowShell",
  "version": "1.0.11",
  "identifier": "com.sparrowshell.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4179",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "title": "SparrowShell",
      "width": 1440,
      "height": 920,
      "minWidth": 1100,
      "minHeight": 700,
      "visible": false,
      "backgroundColor": "#0d1012",
      "hiddenTitle": true,
      "titleBarStyle": "Overlay"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
