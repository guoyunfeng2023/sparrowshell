# 容器监听配置
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8070

# MySQL 5.7：替换为从容器内可访问的数据库地址和独立账号
SPARROWSHELL_MYSQL_URL=jdbc:mysql://host.docker.internal:3306/sparrowshell?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPARROWSHELL_MYSQL_USERNAME=sparrowshell
SPARROWSHELL_MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD

# 通义千问应用不再通过环境变量配置。
# 请编辑 services/sparrowshell-ai/config/application.properties，并在启动容器时挂载到 /app/config/application.properties。

# 可选：DeepSeek 静态命令生成路由；动态 Agent 仍使用通义千问
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 完整平台能力：启用前必须创建数据库并依次执行全部 SQL 迁移
SPARROWSHELL_PLATFORM_PERSISTENCE_ENABLED=true
SPARROWSHELL_PLATFORM_WORKER_ENABLED=true
SPARROWSHELL_USAGE_ENABLED=true
SPARROWSHELL_USAGE_REQUIRED=true
SPARROWSHELL_USAGE_LOCAL_DEVELOPMENT=false
SPARROWSHELL_USAGE_LOCAL_SUBJECT=

# 反馈附件目录，对应容器挂载卷
SPARROWSHELL_FEEDBACK_STORAGE_DIR=/data/feedback

# 邮箱验证码默认关闭。SMTP 密码应使用邮件服务商提供的 SMTP 授权码
SPARROWSHELL_MAIL_ENABLED=false
SPARROWSHELL_MAIL_PROVIDER=smtp
SPARROWSHELL_MAIL_FROM=verify@example.com
SPARROWSHELL_SMTP_HOST=smtp.example.com
SPARROWSHELL_SMTP_PORT=465
SPARROWSHELL_SMTP_USERNAME=verify@example.com
SPARROWSHELL_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SPARROWSHELL_SMTP_PROTOCOL=smtps
SPARROWSHELL_SMTP_AUTH=true
SPARROWSHELL_SMTP_STARTTLS=false

# 可选：腾讯云 SES API 发信。仅在使用 tencent-ses 时配置
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
SPARROWSHELL_SES_REGION=ap-guangzhou
SPARROWSHELL_SES_TEMPLATE_ID=0

# 一次性管理员引导：仅在首次创建管理员时临时设为 true，成功后立即改回 false
SPARROWSHELL_ADMIN_BOOTSTRAP_ENABLED=false
SPARROWSHELL_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
SPARROWSHELL_ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
SPARROWSHELL_ADMIN_BOOTSTRAP_MFA_SECRET=REPLACE_WITH_BASE32_MFA_SECRET

# AI 充值和真实支付默认关闭；不需要收费时保持 disabled
SPARROWSHELL_BILLING_ENABLED=false
SPARROWSHELL_PAYMENT_CHANNEL=disabled
SPARROWSHELL_PUBLIC_BASE_URL=https://example.com/sparrowshell
SPARROWSHELL_LICENSE_KEY_SECRET=REPLACE_WITH_LONG_RANDOM_LICENSE_SECRET
SPARROWSHELL_BILLING_TEST_AMOUNT=

# 仅在明确启用支付宝后填写，私钥不得写入镜像或提交到 Git
SPARROWSHELL_ALIPAY_APP_ID=
SPARROWSHELL_ALIPAY_PRIVATE_KEY=
SPARROWSHELL_ALIPAY_PUBLIC_KEY=
SPARROWSHELL_ALIPAY_SELLER_ID=
